# CareerPilot AI Backend Environment Variables
PROJECT_NAME="CareerPilot AI"
API_V1_STR="/api"

# Optional Gemini API Key.
# When left empty, CareerPilot AI operates automatically in Demo Mode with high-fidelity realistic domain intelligence.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Database Configuration
DATABASE_URL="sqlite:///./careerpilot.db"

# Max Upload Size (Bytes)
MAX_UPLOAD_SIZE_BYTES=10485760

